build/
*/build/
.gradle/
.cxx/                       # NDK/CMake 中间产物(任意层级)
**/.cxx/
.externalNativeBuild/
**/.externalNativeBuild/

# ===== Android Studio / IDE =====
*.iml
.idea/
*.hprof
local.properties

# ===== 签名/密钥(红线:不进库) =====
